# Copy to .env and set your real values before starting.
APP_ENV=production
PORT=8080
MONGO_DATABASE=harbor
MONGO_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
# Generate a secret with: openssl rand -hex 32
JWT_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Optional platform-owner bootstrap. Use a separate login and a strong password.
SUPERADMIN_USERNAME=
SUPERADMIN_PASSWORD=
